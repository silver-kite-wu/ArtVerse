# Copy to a private deployment environment file; generate distinct values for every secret.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Aliyun OSS (V4 signature). Use the internal endpoint on ECS, e.g. https://oss-cn-hangzhou-internal.aliyuncs.com
ARTVERSE_OSS_ENDPOINT=
# Optional: derived from the standard endpoint when empty; required for custom domains
ARTVERSE_OSS_REGION=
ARTVERSE_OSS_BUCKET=artverse-manga
ARTVERSE_OSS_PRIVATE_BUCKET=artverse-generation-private
ARTVERSE_OSS_ACCESS_KEY=
ARTVERSE_OSS_SECRET_KEY=
ARTVERSE_OSS_PUBLIC_BASE_URL=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=artverse
RABBITMQ_HOST=rabbitmq
ARTVERSE_SECRET_ENCRYPTION_KEY=
ARTVERSE_AUTH_RISK_HMAC_KEY=
ARTVERSE_IMAGE_PRODUCER_ENABLED=false
ARTVERSE_IMAGE_WORKER_ENABLED=false
ARTVERSE_IMAGE_COORDINATOR_ENABLED=false
